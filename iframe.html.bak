<html>
<head>
<meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Pete Zah | Iframe</title>
    <link rel="icon" type="image/x-icon" href="/logo.png">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="/storage/css/styles.css">
    <link rel="stylesheet" href="/storage/css/footer.css">

        
</head>
<body>

    <div id="loading-screen">
        <div class="dots">
            <div class="dot"></div>
            <div class="dot"></div>
            <div class="dot"></div>
        </div>
        <h5 id="fetching-text">Fetching assets</h5>
    </div>

    <div class="navbar">
        <div class="navbar-left">
            <a href="/">
                <img src="/logo.png" class="logo">
                <p class="nav-text">Pete Zah</p>
            </a>
        </div>
        <div class="navbar-right">
            <a href="/" class="nav-button"><i class="fas fa-gamepad"></i></a>
            
            
            
            
