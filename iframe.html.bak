<div style="margin-top: 75px;" class="container-iframe">
        <div class="iframe-container">
            <iframe sandbox="allow-scripts allow-pointer-lock allow-forms allow-same-origin allow-downloads" id="myIframe" src=""></iframe>
        </div>
        <div class="controls">
        <i style="margin-left: 15px;" class="fas fa-expand icon" onclick="toggleFullscreen()"></i>
        <i class="fas fa-sync icon" onclick="refreshIframe()"></i>
        <i class="fa-solid fa-comment" id="whysofeinious-button"></i>
        <i style="margin-left: 15px;" class="fa-solid fa-pager" id="openIframeSource"></i>
    </div>


    <h6 style="opacity: 0.5;">BUY YOUR OWN AD BY CLICKING <a style="color: #0000ff;" href="https://docs.google.com/forms/d/e/1FAIpQLSfNGszC5NO2zEov4VtxJkaXuJowzflG13AIGOzl2wHZwRwvrw/viewform?usp=sf_link">HERE</a></h6>

    <script src="/storage/js/iframe.js"></script>
    <script src="/storage/js/script.js"></script>
    <script src="/storage/js/cloak.js"></script>
    <script src="/storage/js/data.js"></script>
    <script src="/storage/js/settings.js"></script>

